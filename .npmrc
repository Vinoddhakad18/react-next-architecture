auto-install-peers=true
strict-peer-dependencies=false
# Flat node_modules layout — avoids symlink issues in Docker on Windows/OneDrive
node-linker=hoisted
# Force hardlink imports (plain link() syscall). Avoids reflink/clone via
# copy_file_range, which is buggy on CentOS 7's 3.10 kernel + overlay2 and
# returns "EPERM: operation not permitted, write" during pnpm install.
package-import-method=hardlink
