auto-install-peers=true
strict-peer-dependencies=false
# Flat node_modules layout — avoids symlink issues in Docker on Windows/OneDrive
node-linker=hoisted
# Copy packages instead of hardlinking from the store — avoids
# "EPERM: operation not permitted, write" on old kernels/overlay2 (e.g. CentOS 7)
package-import-method=copy
