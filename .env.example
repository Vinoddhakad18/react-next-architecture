# Application
PORT=4200
NODE_ENV=development

# Next.js (client-visible)
# Leave EMPTY so the browser talks to the same-origin BFF (/api/...).
# Pointing this at the backend would bypass the BFF and break cookie auth.
NEXT_PUBLIC_API_URL=

# ----------------------------------------------------------------------------
# Server-only backend integration (never exposed to the browser)
# ----------------------------------------------------------------------------
# Base URL of the backend the Next.js route handlers proxy to.
BACKEND_API_URL=http://localhost:3000

# Server-only API key sent as X-API-Key by BFF route handlers. REQUIRED.
API_KEY=czVtZWFyY2hfa2V5LHRlc3Rfa2V5XzEyMyxkZXZfdGVzdF9rZXk=

# Client-visible API key (used when NEXT_PUBLIC_API_URL points at the backend).
NEXT_PUBLIC_API_KEY=czVtZWFyY2hfa2V5LHRlc3Rfa2V5XzEyMyxkZXZfdGVzdF9rZXk=

# ----------------------------------------------------------------------------
# Auth hardening
# ----------------------------------------------------------------------------
# "true" verifies the access-token HS256 signature in middleware using
# JWT_SECRET (only when the BFF and backend share the same secret).
AUTH_VERIFY_SIGNATURE=false

# Required only when AUTH_VERIFY_SIGNATURE=true. Must match the backend secret.
JWT_SECRET=demo-secret-key-for-development-minimum-32-chars-required-here
