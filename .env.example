# Application
PORT=4200
# NODE_ENV options: development, production, test
NODE_ENV=development

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:4200

# Authentication
# Generate a secure secret with: openssl rand -base64 32
# IMPORTANT: Must be at least 32 characters for production
JWT_SECRET=your-secret-key-here-minimum-32-characters-required

# API Key
# Used for API authentication in the X-API-Key header.
#
# API_KEY is SERVER-ONLY and is required by the Next.js API route handlers.
# It is never sent to the browser. Set this in production.
API_KEY=your-server-api-key-here
#
# Backend API base URL used by the server-side route handlers.
BACKEND_API_URL=http://localhost:3000
#
# WARNING: NEXT_PUBLIC_* variables are inlined into the client bundle and are
# visible to anyone. Only set this if the browser genuinely needs an API key;
# do NOT put a real backend secret here.
# NEXT_PUBLIC_API_KEY=your-api-key-here

# Database (optional - for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# POSTGRES_USER=admin
# POSTGRES_PASSWORD=admin123
# POSTGRES_DB=nextjs_db
